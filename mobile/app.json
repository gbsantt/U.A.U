{
  "expo": {
    "name": "UAU",
    "slug": "uau",
    "version": "1.0.0",
    "orientation": "portrait",
    "primaryColor": "#438F0B",
    "icon": "./assets/uau-logo.jpg",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F2E3C4",
        "foregroundImage": "./assets/uau-logo.jpg"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mobile",
      "allowBackup": false
    },
    "web": {
      "name": "UAU",
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/uau-logo.jpg"
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      "expo-secure-store",
      ["expo-splash-screen", {
        "backgroundColor": "#F2E3C4",
        "image": "./assets/uau-logo.jpg",
        "imageWidth": 320,
        "resizeMode": "contain"
      }]
    ]
  }
}
